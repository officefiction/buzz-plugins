{
  "id": "com.buzzplugins.meet",
  "name": "Meet",
  "apiVersion": 1,
  "description": "Your next Google Meet calls inside Buzz: a Join button that opens the meeting in your browser, and one to start a meeting now. First step: connect Google in Settings, Meet.",
  "discovery": {
    "category": "productivity",
    "tags": ["Google Meet", "Calendar", "Calls"]
  },
  "host": {
    "commands": [
      {
        "id": "keychain-read",
        "program": "security",
        "args": ["find-generic-password", "-s", "buzz-meet", "-a", "meet", "-w"]
      },
      {
        "id": "keychain-save",
        "program": "security",
        "args": ["add-generic-password", "-U", "-s", "buzz-meet", "-a", "meet", "-w"],
        "maxInputBytes": 2048
      },
      {
        "id": "keychain-delete",
        "program": "security",
        "args": ["delete-generic-password", "-s", "buzz-meet", "-a", "meet"]
      },
      {
        "id": "secret-read",
        "program": "secret-tool",
        "args": ["lookup", "service", "buzz-meet", "account", "meet"]
      },
      {
        "id": "secret-save",
        "program": "secret-tool",
        "args": ["store", "--label=Meeting assistant (Buzz)", "service", "buzz-meet", "account", "meet"],
        "maxInputBytes": 2048
      },
      {
        "id": "secret-delete",
        "program": "secret-tool",
        "args": ["clear", "service", "buzz-meet", "account", "meet"]
      }
    ],
    "networkOrigins": [
      "https://www.googleapis.com",
      "https://meet.googleapis.com",
      "https://oauth2.googleapis.com"
    ]
  }
}
