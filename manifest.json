{
  "id": "com.officefiction.meet",
  "name": "Meet",
  "apiVersion": 1,
  "description": "Your next Google Meet calls inside Buzz, with a Join button that opens them in your browser. First step: paste your calendar's secret iCal address in Settings, Meet.",
  "discovery": {
    "category": "productivity",
    "tags": ["Google Meet", "Calendar", "Calls"]
  },
  "host": {
    "commands": [
      {
        "id": "keychain-read",
        "program": "security",
        "args": ["find-generic-password", "-s", "buzz-meet", "-a", "meet", "-w"]
      },
      {
        "id": "keychain-save",
        "program": "security",
        "args": ["add-generic-password", "-U", "-s", "buzz-meet", "-a", "meet", "-w"],
        "maxInputBytes": 2048
      },
      {
        "id": "keychain-delete",
        "program": "security",
        "args": ["delete-generic-password", "-s", "buzz-meet", "-a", "meet"]
      },
      {
        "id": "secret-read",
        "program": "secret-tool",
        "args": ["lookup", "service", "buzz-meet", "account", "meet"]
      },
      {
        "id": "secret-save",
        "program": "secret-tool",
        "args": ["store", "--label=Google Calendar iCal address (Buzz)", "service", "buzz-meet", "account", "meet"],
        "maxInputBytes": 2048
      },
      {
        "id": "secret-delete",
        "program": "secret-tool",
        "args": ["clear", "service", "buzz-meet", "account", "meet"]
      }
    ],
    "networkOrigins": ["https://calendar.google.com"]
  }
}
